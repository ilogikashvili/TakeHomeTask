NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://app_user:password@localhost:5432/app
READONLY_DATABASE_URL=postgresql://assistant_readonly:password@localhost:5432/app
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional: set both to enable live Gemini intent interpretation.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# Development only: opt in to the 15-minute demo-login flow used by the UI.
ENABLE_DEMO_LOGIN=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_JWT_ISSUER=ledger-local
AUTH_JWT_AUDIENCE=ledger-api
# For overlapping signing-key rotation, use a JSON map plus its active key ID.
# AUTH_JWT_KEYS={"current":"replace-with-a-random-secret-at-least-32-characters"}
# AUTH_JWT_ACTIVE_KEY=current
REQUESTS_PER_MINUTE=300
ASSISTANT_PER_MINUTE=10
ASSISTANT_PER_DAY=100
ASSISTANT_GLOBAL_PER_DAY=1000
RETENTION_ENABLED=false
RETENTION_DAYS=90
# Optional for creating the isolated *_e2e database on the first test run.
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:password@localhost:5432/postgres
