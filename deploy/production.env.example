NODE_ENV=production
PORT=3000
LOG_LEVEL=info
ENABLE_DEMO_LOGIN=false
# Inject real credentials from your host's secret manager; do not commit them.
# Prisma: sslcert is the trusted server CA; strict also verifies server identity.
DATABASE_URL=postgresql://ledger_runtime:REPLACE@db:5432/ledger?sslmode=require&sslcert=/etc/ledger/db-trust/ca.crt&sslaccept=strict
# node-postgres: sslrootcert is the trusted server CA (different parameter).
READONLY_DATABASE_URL=postgresql://ledger_readonly:REPLACE@db:5432/ledger?sslmode=require&sslrootcert=/etc/ledger/db-trust/ca.crt
AUTH_JWT_KEYS={"current":"REPLACE_WITH_A_CRYPTOGRAPHICALLY_RANDOM_SECRET"}
AUTH_JWT_ACTIVE_KEY=current
AUTH_JWT_ISSUER=your-trusted-issuer
AUTH_JWT_AUDIENCE=ledger-api
CORS_ORIGINS=https://ledger.example.com
REQUESTS_PER_MINUTE=300
ASSISTANT_PER_MINUTE=10
ASSISTANT_PER_DAY=100
ASSISTANT_GLOBAL_PER_DAY=1000
# Enable only after the data owner approves deletion after this period.
RETENTION_ENABLED=false
RETENTION_DAYS=90
# Leave Gemini unset to use the deterministic, local intent parser.
