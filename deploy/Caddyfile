{$PUBLIC_HOST} {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Content-Security-Policy "default-src 'self'; connect-src 'self' wss:; img-src 'self' data:; style-src 'self'; frame-ancestors 'none'"
  }
  handle_path /api/* {
    reverse_proxy backend:3000 {
      flush_interval -1
    }
  }
  handle /socket.io/* {
    reverse_proxy backend:3000
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
